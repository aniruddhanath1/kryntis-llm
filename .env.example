# ─── Kryntis AI Environment Variables ──────────────────────

# Internal API security key (shared with Java Spring Boot)
KRYNTIS_INTERNAL_KEY=change-me-to-a-secure-random-string

# ─── Model Configuration ───────────────────────────────────
KRYNTIS_MODEL_PATH=data/models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
KRYNTIS_MODEL_CONTEXT=4096
KRYNTIS_MODEL_THREADS=4
KRYNTIS_MODEL_GPU_LAYERS=0          # Set >0 to offload to GPU

# ─── Data Paths ────────────────────────────────────────────
KRYNTIS_DATA_DIR=data
KRYNTIS_KNOWLEDGE_DIR=data/knowledge
KRYNTIS_UPLOADS_DIR=data/uploads
KRYNTIS_LOGS_DIR=data/logs

# ─── Service Configuration ─────────────────────────────────
KRYNTIS_SERVICE_HOST=0.0.0.0
KRYNTIS_SERVICE_PORT=8000
KRYNTIS_LOG_LEVEL=INFO

# ─── RAG / Chunking ────────────────────────────────────────
KRYNTIS_CHUNK_SIZE=512
KRYNTIS_CHUNK_OVERLAP=64
KRYNTIS_TOP_K=5

# ─── Internet Research ─────────────────────────────────────
KRYNTIS_INTERNET_ENABLED=true
BRAVE_SEARCH_API_KEY=          # Optional: Brave Search API key
KRYNTIS_MAX_SEARCH_RESULTS=10
KRYNTIS_REQUEST_TIMEOUT=15

# ─── Continual Learning ────────────────────────────────────
KRYNTIS_LEARNING_CONFIDENCE_THRESHOLD=0.75
KRYNTIS_LEARNING_REQUIRE_APPROVAL=false

# ─── Memory ────────────────────────────────────────────────
KRYNTIS_SHORT_TERM_MAX_TURNS=20
KRYNTIS_SHORT_TERM_MAX_TOKENS=2048
KRYNTIS_MEMORY_CONSOLIDATION_INTERVAL=3600   # seconds
