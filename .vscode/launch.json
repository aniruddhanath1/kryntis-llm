{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kryntis: Serve API (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["serve"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Kryntis: Generate All Datasets",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["generate-datasets"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Kryntis: Train All Domains (Sequential)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train.py",
      "args": ["--domain", "general", "--epochs", "3"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Kryntis: Train Domain - Coding",
