# ==============================================================================
# Kryntis AI — .gitignore
# ==============================================================================

# ── 1. Python & Bytecode ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── 2. Virtual Environments ───────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── 3. Secrets, Keys & Environment Variables ──────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.cert
*.crt
.env-encryption.key
.env-develop
.env-stage
.env-qa
.env-prod

# ── 4. Trained Models, Weights, Tokenizers & Checkpoints ──────────────────────
checkpoints/
data/models/checkpoints/
data/tokenizer/
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.gguf

# ── 5. Databases, Memory & Session Context Stores ─────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/sessions/
data/sessions_test*
data/repo_test*
data/chroma/
data/vectors/
data/cache/

# ── 6. Training datasets ──────────────────────────────────────────────────────
data/raw/*
data/processed/*

# ── 7. Raw & Processed Datasets (Keep data directory structure) ───────────────
data/raw/*.tar.gz
data/raw/*.zip
data/raw/*.parquet
data/processed/*.npy
data/processed/*.arrow
!data/raw/.gitkeep
!data/processed/.gitkeep

# ── 8. Testing, Linting & Type Checking ───────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ── 9. Logs, Profiling & Runtime Artifacts ────────────────────────────────────
logs/
*.log
*.log.*
nohup.out
gmon.out
.prof
.benchmarks/

# ── 10. IDE & Editor Specifics ─────────────────────────────────────────────────
# PyCharm
.idea/workspace.xml
.idea/shelf/
.idea/caches/
.idea/libraries/
.idea/httpRequests/
.idea/sonarlint/
.idea/**/contentModel.xml
.idea/dataSources/
.idea/dataSources.local.xml

# VSCode
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
*.code-workspace
.history/

# ── 11. Operating System Artifacts ────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk
